{
  "name": "clinicq-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target node",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "bun run prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "bun test",
    "eval:assistant": "bun run src/app/modules/assistant/evals/run.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.98",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ai": "7.0.142",
    "argon2": "0.45.1",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "socket.io": "4.8.4",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/uuid": "11.0.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.12.0",
    "typescript": "7.0.2"
  }
}
