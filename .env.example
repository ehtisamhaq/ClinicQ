# Root Environment Template for ClinicQ Monorepo

# API Service
API_PORT=4000
DATABASE_URL="postgresql://clinicq:clinicq_dev@localhost:5432/clinicq?schema=public"

# Auth Secrets
JWT_ACCESS_SECRET="change_me_access_secret_at_least_32_chars"
JWT_REFRESH_SECRET="change_me_refresh_secret_at_least_32_chars"

# LLM & AI Assistant (OpenAI, Google AI Studio, etc.)
LLM_PROVIDER="openai"
LLM_API_KEY="sk-..."
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Web Client
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
